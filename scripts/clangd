#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
exec "$root/scripts/in-env" sh -c '
    set -eu
    root=$1
    shift
    # Generate the compilation database before clangd reads it, even on first
    # open. Reconfigure on restart to refresh toolchain paths after Nix updates.
    # Keep CMake output off stdout, which belongs to the language protocol.
    (cd -- "$root" && cmake --preset course) >&2

    # Only allow compiler probes for the pinned Nix AVR toolchain, never an
    # arbitrary compiler path from a workspace compilation database.
    exec clangd \
        "--query-driver=/nix/store/*-mpt-dev-tools/bin/avr-gcc,/nix/store/*-mpt-dev-tools/bin/avr-g++,/nix/store/*-avr-gcc-wrapper-*/bin/avr-gcc,/nix/store/*-avr-gcc-wrapper-*/bin/avr-g++" "$@"
' sh "$root" "$@"
