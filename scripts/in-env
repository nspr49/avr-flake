#!/bin/sh
# Preserve cwd for tooling such as CMake Tools and clangd.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
shell=$root
if [ "${1:-}" = --debug ]; then
    shift
    if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
        printf '%s\n' 'Bloom debugging is available only on x86_64 Linux (including x86_64 WSL2 with USB forwarding). See README.md.' >&2
        exit 1
    fi
    # The VS Code adapter starts Bloom next to the GDB wrapper; Bloom needs
    # the workspace root to find bloom.yaml.
    if [ "${1:-}" = bloom ]; then
        cd -- "$root"
    fi
    shell=$root'#debug'
elif [ "${MPT_DEV_SHELL:-}" = 1 ]; then
    exec "$@"
fi
if command -v nix >/dev/null 2>&1; then
    nix=nix
elif [ -x /nix/var/nix/profiles/default/bin/nix ]; then
    nix=/nix/var/nix/profiles/default/bin/nix
elif [ -x "$HOME/.nix-profile/bin/nix" ]; then
    nix=$HOME/.nix-profile/bin/nix
else
    printf '%s\n' 'Nix not found. Install Nix in this OS (inside Linux for WSL), then restart your editor.' >&2
    exit 127
fi

exec "$nix" --extra-experimental-features 'nix-command flakes' develop --no-update-lock-file "$shell" --command "$@"
