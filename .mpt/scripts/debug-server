#!/bin/sh
set -eu
script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
cd -- "$script_dir/../.."

# Debug the existing firmware without requiring GDB to load it or using flash breakpoints.
exec "$script_dir/in-env" --debug pyavrocd --once \
    --device avr128db48 --interface updi --tool nedbg --port 1442 \
    --elf-file build/avr128db48_project.elf --onlywhenloaded disable --breakpoints hardware
