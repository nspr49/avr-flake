{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build, Flash, and Debug Curiosity Nano",
      "type": "gdbtarget",
      "request": "launch",
      "program": "${workspaceFolder}/build/avr128db48_project.elf",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build and Flash Curiosity Nano",
      "gdb": "${workspaceFolder}/.mpt/scripts/gdb",
      "run": "all",
      "target": {
        "type": "remote",
        "host": "127.0.0.1",
        "server": "${workspaceFolder}/.mpt/scripts/debug-server",
        "serverParameters": [],
        "serverPortRegExp": "Listening on port ([0-9]+) for gdb connection",
        "portDetectionTimeout": 20000
      }
    },
    {
      "name": "Build and Flash Curiosity Nano (no debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build and Flash Curiosity Nano",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "exit 0"],
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Build Firmware Only",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build firmware",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "exit 0"],
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
